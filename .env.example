# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...replace_me

# ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=111111111,222222222

# Ссылка на сайт оплаты. Можно подставить {user_id} — он будет подставлен в URL
PAYMENT_URL=https://example.com/pay?tariff=1
PAYMENT_AMOUNT=1 ₽

# Секретный токен для колбэка оплаты с сайта
PAYMENT_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# Локальный сервер колбэка (для сайтов, которые дёргают ваш домен)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081

# База данных
DB_PATH=data/bot.db